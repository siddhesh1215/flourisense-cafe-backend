  "item": [
    {
      "name": "ORDERS MANAGEMENT",
      "item": [
        {
          "name": "Get All Orders",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/orders?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "orders"],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "disabled": false
                },
                {
                  "key": "limit",
                  "value": "10",
                  "disabled": false
                },
                {
                  "key": "status",
                  "value": "1",
                  "disabled": true
                },
                {
                  "key": "date_from",
                  "value": "2026-05-01",
                  "disabled": true
                },
                {
                  "key": "date_to",
                  "value": "2026-05-02",
                  "disabled": true
                }
              ]
            },
            "description": "Get all orders with pagination and filtering"
          }
        },
        {
          "name": "Get Single Order",
          "request": {
            "method": "GET",
            "header": [
              {
